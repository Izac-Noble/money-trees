# Local development only. Copy values into your shell or a local .env; never commit real ones.
# Deployed values are set in the Render and Vercel dashboards (see README "Deploying").

# --- api ---
# development | staging | production. Returned by GET /health.
APP_ENV=development
# Comma-separated browser origins allowed to call the API. "*" is rejected.
# Unset means only http://localhost:5173 is allowed.
ALLOWED_ORIGINS=http://localhost:5173

# --- web (build time) ---
# Base URL of the API. Leave empty locally to use the Vite dev proxy.
VITE_API_URL=
# The web build also reads APP_ENV (above): anything other than "production"
# adds <meta name="robots" content="noindex, nofollow"> to index.html.
# Where the Vite dev server proxies /health during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8000
