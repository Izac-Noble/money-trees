# Copy to .env (api) and web/.env.local (web). Never commit real values.

# --- api ---
# Reported by GET /health. One of: development, staging, production.
MONEY_TREES_ENV=development

# --- web (Vite only exposes VITE_* to the browser) ---
# Base URL the browser uses to reach the API. Leave empty in local dev to use the Vite proxy.
VITE_API_URL=
# Where the Vite dev server proxies /health during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8000
