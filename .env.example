# Local development only. Never commit real values.
# Deployed values are set in Vercel → Project → Settings → Environment Variables
# (see README "Deploying").

# development | preview | staging | production
# - API: returned by GET /api/health.
# - Web: read at build time; anything other than "production" adds
#   <meta name="robots" content="noindex, nofollow"> to index.html.
APP_ENV=development

# Local only: where the Vite dev server proxies /api during `npm run dev`.
API_PROXY_TARGET=http://localhost:8000
